# Production Environment Variables
# This file is now gitignored - it's a local reference only.
# Set the REAL values in Vercel's dashboard (Project Settings -> Environment Variables), not here.
NODE_ENV=production

# Payload CMS
NEXT_PUBLIC_PAYLOAD_URL=https://<your-actual-vercel-domain>.vercel.app
PAYLOAD_SECRET=<generate-a-new-random-secret>

# Neon PostgreSQL Database (rotate this password in the Neon dashboard - it was previously exposed in a public repo)
DATABASE_URL=<set-in-vercel-dashboard-after-rotating>
