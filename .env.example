# Database (Postgres connection string - e.g. from Neon, Supabase, or Vercel Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio_db
# Optional: overrides DATABASE_URL when set (useful for a separate prod DB on Vercel)
PROD_DATABASE_URL=

# Payload CMS
PAYLOAD_SECRET=your-secret-key-change-this
NEXT_PUBLIC_URL=http://localhost:3000
